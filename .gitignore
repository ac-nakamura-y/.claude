# ~/.claude is Claude Code's live directory and holds a lot of machine-generated
# runtime data (projects, sessions, security, telemetry, plugins cache, ...).
# Ignore everything by default, then allow only the version-controlled config.
/*

!/.github/
!/.gitignore
!/.gitmodules
!/CLAUDE.md
!/README.md
!/scripts/
!/settings.json
!/skills/
!/plugins/
!/plugins/agent-config
plugins/cache/
plugins/known_marketplaces.json
plugins/installed_plugins.json
plugins/marketplaces/

# macOS
.DS_Store
**/.DS_Store

# Notion skill local config (copy from .env.example)
skills/notion/.env
