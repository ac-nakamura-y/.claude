# ~/.claude is Claude Code's live directory and holds a lot of machine-generated
# runtime data (projects, sessions, security, telemetry, plugins cache, ...).
# Ignore everything by default, then allow only the version-controlled config.
/*

!/.github/
!/.gitignore
!/.gitmodules
!/CLAUDE.md
!/README.md
!/scripts/
!/settings.json
!/skills/
!/plugins/
/plugins/*
!/plugins/agent-config
!/scheduled-tasks/
/scheduled-tasks/*
!/scheduled-tasks/fde-dashboard/
/scheduled-tasks/fde-dashboard/*.html
!/scheduled-tasks/do3/
!/scheduled-tasks/auto-review/

# macOS
.DS_Store
**/.DS_Store

# Skills that other tools place and update here are not version-controlled.
/skills/synced/
/skills/ego-browser
/skills/orca-cli
/skills/orca-computer-use
/skills/orchestration
