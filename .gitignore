# Trinity runtime artifacts (per-run dirs, log)
.trinity/

# Backups created by bin/install.sh
*.bak.*

# Claude Code runtime state — only ever appears here if a stray symlink leaked.
# These dirs are managed by Claude Code under the real ~/.claude/ and must not
# be checked into this repo.
/sessions/
/projects/
/todos/
/file-history/
/cache/
/statsig/
/telemetry/
/shell-snapshots/
/session-env/
/state/
/debug/
/downloads/
/paste-cache/
/chrome/
/ide/
/backups/
/plugins/cache/
/plugins/data/
/plugins/marketplaces/
/plugins/installed_plugins.json
/plugins/known_marketplaces.json
/plugins/install-counts-cache.json

# Local-only settings overrides
settings.local.json
.claude/settings.local.json

# Misc Claude Code runtime files
history.jsonl
mcp-needs-auth-cache.json
stats-cache.json
.claude.json
