# Copy to .env and fill in values for your Notion workspace.
# NOTION_USER_ID: Notion settings URL or browser devtools request header x-notion-active-user-header
# NOTION_SPACE_ID: browser devtools request header x-notion-space-id
# NOTION_DB: local SQLite database synced by the Notion desktop app
NOTION_USER_ID=
NOTION_SPACE_ID=
NOTION_DB=~/Library/Application Support/Notion/notion.db
