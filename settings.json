{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(jq -r '.tool_input.file_path // empty' 2>/dev/null)\"; case \"$f\" in */agents/*.md|*/commands/*.md) head -1 \"$f\" 2>/dev/null | grep -q '^---$' || echo 'WARN: agent/command file missing YAML frontmatter delimiter ---' >&2 ;; esac"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(ls:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx eslint:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx jest:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(mypy:*)"
    ]
  }
}
