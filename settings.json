{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/auto-resume/detect.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/language-drift/check.mjs\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/report-gaps/check.mjs\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/auto-review/close.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "trinity@yjn279": true,
    "eli5@claude-community": true,
    "fde@activecore": true,
    "ops@activecore": true,
    "logistics@activecore": true,
    "batb@batb": true,
    "ac-monitor@activecore": true,
    "shiseido@activecore": true
  },
  "extraKnownMarketplaces": {
    "yjn279": {
      "source": {
        "source": "github",
        "repo": "yjn279/trinity"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "claude-community": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-community.git"
      }
    },
    "activecore": {
      "source": {
        "source": "github",
        "repo": "activecore-org/agent-config"
      }
    },
    "batb": {
      "source": {
        "source": "github",
        "repo": "ac-nakamura-y/batb"
      }
    }
  },
  "outputStyle": "Concise",
  "cleanupPeriodDays": 90,
  "idleCompaction": false,
  "advisorModel": "fable",
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
